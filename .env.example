# RetailPulse AI Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL or local SQLite fallback)
# PostgreSQL connection string example:
# DATABASE_URL=postgresql://retail_user:retail_pass@localhost:5432/retailpulse_db
# Local SQLite fallback default:
DATABASE_URL=sqlite:///./data/retailpulse.db

# OpenAI API Key (for GenAI Business Analyst)
# If empty, the platform seamlessly utilizes deterministic analytical AI synthesis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ML & Analytics Settings
DATA_DIR=./data
MODEL_DIR=./backend/app/ml/models
FORECAST_HORIZON_DAYS=90
CHURN_INACTIVE_DAYS=180
